{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "query",
      "type": "debugpy",
      "request": "launch",
      // "program": "${workspaceFolder}/main.py",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "APP_MODE" : "query"        
      }
    },
    {
      "name": "inegst",
      "type": "debugpy",
      "request": "launch",
      // "program": "${workspaceFolder}/main.py",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "APP_MODE" : "ingest"        
      }
    }
  ]
}
